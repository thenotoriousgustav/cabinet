PORT=4000
DATABASE_URL="postgresql://localhost:5432/atlas?schema=public"

# Generate a unique secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

COOKIE_DOMAIN="localhost"
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# OAuth callback URLs: ${API_URL}/v1/auth/callback/{github|google}
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ADMIN_EMAIL="admin@gustam.dev"
ADMIN_PASSWORD="password123"
ADMIN_NAME="Gustam"

# Explicit User UUID allowlist for /cabinet/operations; blank denies access to everyone.
OPERATIONS_USER_IDS=""

# Preserve existing queues. Isolated deployments need both a unique prefix and a separate database.
BULLMQ_PREFIX="bull"

# Cloudflare R2 Storage (S3-compatible)
R2_ENDPOINT="https://66bf13c07da66763af363b7c8ff9a55d.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cabinet"
# Optional public domain or r2.dev URL (e.g. https://pub-xxx.r2.dev or https://media.yourdomain.com)
R2_PUBLIC_URL=""
