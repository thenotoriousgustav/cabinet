datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique
  emailVerified Boolean     @default(false)
  sessions      Session[]
  accounts      Account[]
  name          String
  avatar        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  folders       Folder[]
  bookmarks     Bookmark[]
  tags          Tag[]
  folderMemberships FolderMember[]
  savedSearches SavedSearch[]
  backgroundTasks BackgroundTask[]
  onboardingDismissed Boolean @default(false)
  extensionLastSeenAt DateTime?

  @@map("users")
}

model BackgroundTask {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  kind String @db.VarChar(24)
  activeKey String? @unique @db.VarChar(80)
  status String @default("PENDING") @db.VarChar(24)
  payload Json?
  total Int @default(0)
  processed Int @default(0)
  failed Int @default(0)
  attempt Int @default(0)
  error String? @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  finishedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("background_tasks")
}

model SavedSearch {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String @db.VarChar(80)
  url String @db.VarChar(2000)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("saved_searches")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model Folder {
  id          String    @id @default(uuid()) @db.Uuid
  shareToken  String?   @unique @db.VarChar(64)
  inviteTokenHash String? @unique @db.VarChar(64)
  /// Role granted to people who join through the invitation link.
  inviteRole  FolderRole @default(CONTRIBUTOR)
  name        String
  description String?
  parentId    String?   @db.Uuid
  userId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderToFolder")
  bookmarks Bookmark[]
  members FolderMember[]

  @@map("folders")
}

model FolderMember {
  folderId String @db.Uuid
  userId String @db.Uuid
  role FolderRole @default(CONTRIBUTOR)
  createdAt DateTime @default(now())
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@index([userId])
  @@map("folder_members")
}

model Bookmark {
  id             String               @id @default(uuid()) @db.Uuid
  type           BookmarkType         @default(BOOKMARK)
  url            String?
  title          String
  description    String?
  notes          String?              @db.Text
  noteDocument   Json?
  noteRevision   Int                  @default(0)
  noteSaveId     String?              @db.Uuid
  /// An account-scoped request ID makes create retries safe after a lost response.
  clientRequestId String?             @db.Uuid
  source         String               @default("WEB") @db.VarChar(16)
  /// Excalidraw scene of a DRAWING item: elements, a small app state, and embedded files.
  drawing        Json?
  imageUrl       String?
  faviconUrl     String?
  siteName       String?
  contentType    BookmarkContentType?
  metadataStatus MetadataStatus       @default(PENDING)
  metadataError  String?
  metadataTitlePending Boolean @default(false)
  lastEnrichedAt DateTime?
  isPinned       Boolean              @default(false)
  sortTitle      String               @default("")
  sortDomain     String?
  isFavorite     Boolean              @default(false)
  isArchived     Boolean              @default(false)
  folderId       String?              @db.Uuid
  userId         String               @db.Uuid
  status         String               @default("OK")
  statusCode     Int?
  position       Int                  @default(0)
  lastChecked    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags   Tag[]   @relation("BookmarkTags")

  @@index([userId, deletedAt, isPinned(sort: Desc), position])
  @@index([userId, folderId, deletedAt])
  @@unique([userId, clientRequestId])
  @@index([metadataStatus])
  @@index([type])
  @@map("bookmarks")
}

/// What a folder member may do. The folder owner always has full access.
/// VIEWER sees items; CONTRIBUTOR also adds items and manages their own;
/// EDITOR also edits the content of, and trashes, anyone's links in the folder.
enum FolderRole {
  VIEWER
  CONTRIBUTOR
  EDITOR
}

enum BookmarkType {
  BOOKMARK
  NOTE
  DRAWING
}

enum BookmarkContentType {
  SOCIAL_POST
  IMAGE
  VIDEO
  ARTICLE
  LINK
  PDF
  UNKNOWN
}

enum MetadataStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks Bookmark[] @relation("BookmarkTags")

  @@unique([name, userId])
  @@index([userId])
  @@map("tags")
}
